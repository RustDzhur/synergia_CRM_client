# Домены берутся из SITE_DOMAINS (см. .env). Сертификаты Let's Encrypt Caddy получает и продлевает сам —
# нужно лишь, чтобы A-запись домена уже указывала на этот сервер и были открыты порты 80 и 443.
{$SITE_DOMAINS} {
	encode zstd gzip
	reverse_proxy crm:3000
}

# Панель OmniRoute (раньше omiroute.firmspace.eu на старом сервере); A-запись должна указывать на этот сервер
omiroute.firmspace.eu {
	handle /live-ws* {
		reverse_proxy omniroute:20132
	}
	handle {
		reverse_proxy omniroute:20128
	}
}
