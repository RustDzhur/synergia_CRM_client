# Скопируйте в .env (chmod 600). Значения JWT_SECRET, ENCRYPTION_KEY и CRON_SECRET берите со старого сервера —
# иначе сессии и сохранённые токены интеграций перестанут работать. Остальные переменные старого .env тоже перенесите.

SITE_DOMAINS=firmspace.de, www.firmspace.de
APP_URL=https://firmspace.de

# Версия PostgreSQL: НЕ ниже, чем на старом сервере (проверка: docker exec postgres postgres --version)
PG_VERSION=16
POSTGRES_PASSWORD=ЗАМЕНИТЬ
# Тот же пароль, что в POSTGRES_PASSWORD (подстановок внутри .env нет — впишите явно)
DATABASE_URL=postgresql://crm_app:ЗАМЕНИТЬ@postgres:5432/crm?schema=public

JWT_SECRET=СО_СТАРОГО_СЕРВЕРА
ENCRYPTION_KEY=СО_СТАРОГО_СЕРВЕРА_ЕСЛИ_ЗАДАН
CRON_SECRET=СО_СТАРОГО_СЕРВЕРА

LOCAL_STORAGE_ROOT=/data/storage

# Узбекский голос (docs/UZ_VOICE.md). Всё необязательно.
# Модель распознавания для узбекского (по умолчанию gpt-4o-transcribe):
# AI_VOICE_STT_MODEL_UZ=
# Отдельный распознаватель с узбекским (ElevenLabs Scribe): если ключ задан, для узбекского он идёт первым
# ELEVENLABS_API_KEY=
