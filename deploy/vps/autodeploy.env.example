# Настройки автоматической выкладки боевого стека (deploy/vps).
# Положить рядом со скриптом как deploy/vps/autodeploy.env — файл читает сам autodeploy.sh.
#
# Ветка выкладки — deploy: CI (.github/workflows/ci.yml, задача publish-deploy) публикует в неё
# только коммит с зелёными проверками, поэтому серверу не нужен доступ к API GitHub для проверки CI.
# Прежнее значение main оставлено в deploy/autodeploy.env.example — оно относится к старому
# одиночному серверу (deploy/docker-compose.yml), а не к боевому стеку.
DEPLOY_BRANCH=deploy
REPO_SLUG=RustDzhur/synergia_CRM_client
# 1 — выкладывать только коммит с зелёным CI (рекомендуется).
REQUIRE_CI=1
