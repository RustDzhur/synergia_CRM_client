# Переменные окружения дубликата CRM (положить рядом с docker-compose.yml как .env, права 600)

# База: контейнер postgres в общей сети infrastructure, отдельная база crm (не MongoDB оригинала)
DATABASE_URL=postgresql://crm_app:ПАРОЛЬ@postgres:5432/crm?schema=public

# Совпадает с оригиналом: им подписаны сессии и (по умолчанию) зашифрованы секреты интеграций
JWT_SECRET=ЗАМЕНИТЬ

# Публичный адрес контура. Пока Caddy не настроен — адрес сервера в WireGuard-сети
APP_URL=http://10.50.0.1:3210

# Каталог файлового хранилища внутри контейнера (том crm_storage)
LOCAL_STORAGE_ROOT=/data/storage

# Защита крона напоминаний
CRON_SECRET=ЗАМЕНИТЬ

# Быстрая модель для голосовых ответов Айрис (≈2,7 с на круг против 3–13 с у основной); не ответила — запрос уходит на AI_MODEL
# AI_VOICE_MODEL=auto/claude-haiku
