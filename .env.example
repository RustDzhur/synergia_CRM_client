# ── Обязательные ──────────────────────────────────────────────────────────
MONGODB_URI=
JWT_SECRET=

# ── Интеграции (см. docs/INTEGRATIONS.md) ─────────────────────────────────
# Публичный адрес сайта: по нему Telegram, Viber, Twilio и Meta присылают вебхуки, а Google/Microsoft возвращают пользователя
# после входа. На Vercel укажите адрес продакшена, например https://crm.example.com (без слэша в конце).
APP_URL=

# Ключ шифрования токенов провайдеров в базе. Если не задан — используется JWT_SECRET.
# Меняя его, вы делаете уже сохранённые подключения нечитаемыми (их придётся ввести заново).
ENCRYPTION_KEY=

# Вход в почту «через Google» (Google Cloud Console → OAuth client, Redirect URI: APP_URL/api/mail/oauth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Вход в почту «через Microsoft» (Azure → App registrations, Redirect URI: APP_URL/api/mail/oauth/callback)
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Оплата тарифов через Stripe (см. docs/PAYMENTS.md). Без STRIPE_SECRET_KEY кнопки покупки на странице Upgrade отключены.
# Ключи: dashboard.stripe.com → Developers → API keys (для проверки — тестовые sk_test_…, для боя — sk_live_…).
STRIPE_SECRET_KEY=
# Секрет вебхука: Developers → Webhooks → добавить адрес APP_URL/api/webhooks/stripe → «Signing secret» (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Хранилище файлов и фото — Firebase Storage (см. docs/DOCUMENTS.md; нужен тариф Blaze, есть бесплатная квота)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=

# Администратор платформы: e-mail (через запятую), которым открывается админ-кабинет /crm/admin (управление подписками клиентов).
# Сначала зарегистрируйте этот аккаунт, потом добавьте адрес сюда.
ADMIN_EMAILS=

# Секрет для ежесуточного запуска отложенных действий автоматизации (Vercel Cron передаёт его в заголовке Authorization)
CRON_SECRET=

# Оплата криптовалютой (NOWPayments, см. docs/PAYMENTS.md): ключ API и секрет уведомлений (IPN) из кабинета nowpayments.io
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Реклама (Marketing → Ad performance, карточка «Advertising» на Dashboard). См. docs/ADS.md
# Google Ads: тот же вход Google (GOOGLE_CLIENT_ID/SECRET) + developer token из Google Ads (менеджерский аккаунт → API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=
# Meta Ads: приложение на developers.facebook.com с правом ads_read
META_APP_ID=
META_APP_SECRET=

# ИИ-ассистент (Ctrl/⌘ + K, кнопка ✨ в шапке). См. docs/AI.md. Достаточно ключа ОДНОГО провайдера.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# необязательно: AI_PROVIDER=anthropic|openai (если заданы оба ключа), AI_MODEL=<имя модели>, AI_DAILY_LIMIT=<запросов в сутки на фирму, одно число для всех тарифов>
