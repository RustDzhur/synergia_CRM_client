# ── Обязательные ──────────────────────────────────────────────────────────
MONGODB_URI=
JWT_SECRET=

# ── Интеграции (см. docs/INTEGRATIONS.md) ─────────────────────────────────
# Публичный адрес сайта: по нему Telegram, Viber, Twilio и Meta присылают вебхуки, а Google/Microsoft возвращают пользователя
# после входа. На Vercel укажите адрес продакшена, например https://crm.example.com (без слэша в конце).
APP_URL=

# Ключ шифрования токенов провайдеров в базе. Если не задан — используется JWT_SECRET.
# Меняя его, вы делаете уже сохранённые подключения нечитаемыми (их придётся ввести заново).
ENCRYPTION_KEY=

# Вход в почту «через Google» (Google Cloud Console → OAuth client, Redirect URI: APP_URL/api/mail/oauth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Вход в почту «через Microsoft» (Azure → App registrations, Redirect URI: APP_URL/api/mail/oauth/callback)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
