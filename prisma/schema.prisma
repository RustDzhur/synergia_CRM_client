  createdByName String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("sharelinks")
}

model Stage {
  id        String   @id @default(cuid())
  owner     String
  name      String
  order     Float
  color     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

