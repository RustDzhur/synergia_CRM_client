model Warehouse {
  id        String   @id @default(cuid())
  org       String
  name      String
  kind      String   @default("warehouse")
  address   String   @default("")
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

// Код подтверждения почты при регистрации: хранится только хеш, живёт 15 минут, не больше 5 попыток ввода
model EmailCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sends     Int      @default(1)
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@map("emailcodes")
}

// Каждый учтённый платёж по счёту. Уникальный (org, source, externalId) делает учёт идемпотентным: повторная доставка
// webhook, второй клик «оплачен» или повторная привязка банковской строки не прибавят сумму второй раз.
// amount со знаком: возврат платежа (отвязка банковского движения) записывается отрицательной суммой.
model PaymentEvent {
  id         String   @id @default(cuid())
  org        String
  invoice    String
  source     String   // manual | assistant | webhook | bank
  externalId String
  amount     Float
  currency   String   @default("EUR")
  via        String   @default("")
  createdAt  DateTime @default(now())

  @@unique([org, source, externalId])
  @@index([org, invoice])
  @@map("paymentevents")
}

// Каталог ролей роботов Робот-офиса. Хранится в базе, чтобы администратор платформы правил роли без выкладки.
// Начальные роли подгружаются из lib/office/templates.ts один раз (существующие записи сидом не перезаписываются).
model RobotTemplate {
  id        String   @id
  name      String
  zone      String
  accent    String
  skills    String[] @default([])
  duties    String   @default("")
  platform  Boolean  @default(false)
  routines  Json?
  // рынки, для которых роль предлагается при найме; пусто — для всех
  markets   String[] @default([])
  // название и описание по языкам: { de: {title, desc}, en: {...}, ua: {...}, uz: {...} }; пусто — берутся из переводов интерфейса
  texts     Json?
  starter   Boolean  @default(false)
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("robot_templates")
}
