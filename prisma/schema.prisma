  active          Boolean   @default(true)
  contact         String?
  company         String?
  customerName    String
  customerAddress String    @default("")
  customerTaxId   String    @default("")
  items           Json?
  currency        String    @default("EUR")
  notes           String    @default("")
  interval        String    @default("monthly")
  dayOfMonth      Float     @default(1)
  autoSend        Boolean   @default(false)
  nextRunDate     String
  lastRunAt       DateTime?
  lastInvoice     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("recurringinvoices")
}

model SectionRecord {
