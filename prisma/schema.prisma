}

model Warehouse {
  id        String   @id @default(cuid())
  org       String
  name      String
  kind      String   @default("warehouse")
  address   String   @default("")
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

// Код подтверждения почты при регистрации: хранится только хеш, живёт 15 минут, не больше 5 попыток ввода
model EmailCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sends     Int      @default(1)
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@map("emailcodes")
}

// Каждый учтённый платёж по счёту. Уникальный (org, source, externalId) делает учёт идемпотентным: повторная доставка
// webhook, второй клик «оплачен» или повторная привязка банковской строки не прибавят сумму второй раз.
// amount со знаком: возврат платежа (отвязка банковского движения) записывается отрицательной суммой.
model PaymentEvent {
  id         String   @id @default(cuid())
  org        String
  invoice    String
  source     String   // manual | assistant | webhook | bank
  externalId String
  amount     Float
  currency   String   @default("EUR")
  via        String   @default("")
  createdAt  DateTime @default(now())

  @@unique([org, source, externalId])
  @@index([org, invoice])
  @@map("paymentevents")
}

// Каталог ролей роботов Робот-офиса. Хранится в базе, чтобы администратор платформы правил роли без выкладки.
// Начальные роли подгружаются из lib/office/templates.ts один раз (существующие записи сидом не перезаписываются).
model RobotTemplate {
  id        String   @id
  name      String
  zone      String
  accent    String
  skills    String[] @default([])
  duties    String   @default("")
  platform  Boolean  @default(false)
  routines  Json?
  // рынки, для которых роль предлагается при найме; пусто — для всех
  markets   String[] @default([])
  // название и описание по языкам: { de: {title, desc}, en: {...}, ua: {...}, uz: {...} }; пусто — берутся из переводов интерфейса
  texts     Json?
  starter   Boolean  @default(false)
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("robot_templates")
}

// Налоговые правила рынка с датами действия и источником. Документ считается по правилу, действовавшему на его дату;
// изменение закона = новая запись, не правка кода. verifiedBy пуст, пока специалист рынка не подтвердил запись.
model TaxRule {
  id         String    @id @default(cuid())
  market     String
  code       String
  title      Json?
  rate       Float?
  params     Json?
  validFrom  String
  validTo    String?
  source     String    @default("")
  sourceUrl  String    @default("")
  note       String    @default("")
  verifiedBy String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([market, code, validFrom])
  @@index([market, code])
  @@map("tax_rules")
}

// ── Практика: бухгалтеры и юристы, ведущие несколько фирм-клиентов (docs/TZ_MASTER.md §5) ─────────────────────────────
// Практика — рабочий кабинет специалиста, а не посредник: клиентов приглашают вручную, каталога специалистов нет.
model Practice {
  id               String   @id @default(cuid())
  name             String
  // accountant | lawyer: определяет роль специалиста в фирме клиента (advisor | counsel)
  kind             String   @default("accountant")
  market           String   @default("")
  // короткий код практики: клиент по нему приглашает «своего» специалиста
  code             String   @unique
  ownerUser        String
  // акцепт договора обработки данных и обязательства о сохранении тайны (тексты готовит юрист; платформа хранит версию и время)
  termsVersion     String   @default("")
  termsAcceptedAt  DateTime?
  termsAcceptedBy  String   @default("")
  // режим ИИ для данных клиентов практики: none (без ИИ) | own (только подключённый ключ фирмы) | platform
  aiMode           String   @default("none")
  // оплачено до (подписка практики, ТЗ §5.4); пусто — бесплатный режим
  paidUntil        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("practices")
}

model PracticeMember {
  id        String   @id @default(cuid())
  practice  String
  user      String
  // partner | senior | junior | assistant
  role      String   @default("junior")
  createdAt DateTime @default(now())

  @@unique([practice, user])
  @@index([user])
  @@map("practice_members")
}

// Связь практики с фирмой клиента. org пуст, пока клиент не принял приглашение практики по токену.
model ClientLink {
  id            String    @id @default(cuid())
  practice      String
  org           String?
  // invited | active | ended
  status        String    @default("invited")
  // practice | client — кто пригласил
  initiatedBy   String    @default("practice")
  token         String    @unique
  // read | review | edit
  access        String    @default("read")
  modules       String[]  @default([])
  // сотрудники практики, получившие доступ к фирме клиента
  members       String[]  @default([])
  note          String    @default("")
  invitedByUser String    @default("")
  confirmedBy   String    @default("")
  confirmedAt   DateTime?
  expiresAt     DateTime?
  endedAt       DateTime?
  endedBy       String    @default("")
  endReason     String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([practice, status])
  @@index([org, status])
  @@map("client_links")
}

// Единая запись согласия: кому, зачем, что, срок, отзыв. Доступ специалиста (и позже банка) работает только через действующее согласие.
model ConsentRecord {
  id          String    @id @default(cuid())
  org         String
  // practice_access | bank_connect | bank_lead
  kind        String
  subjectType String
  subjectId   String
  purpose     String    @default("")
  scope       Json?
  grantedBy   String
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedBy   String    @default("")
  version     String    @default("1")

  @@index([org, kind])
  @@index([subjectType, subjectId])
  @@map("consent_records")
}

// Журнал доступа специалиста к данным фирмы: виден клиенту (записи — по запросам advisor/counsel)
model AccessLogEntry {
  id       String   @id @default(cuid())
  org      String
  link     String
  user     String
  userName String   @default("")
  // read | write
  action   String
  module   String   @default("")
  method   String   @default("")
  path     String   @default("")
  at       DateTime @default(now())

  @@index([org, at])
  @@index([link, at])
  @@map("access_log")
}

// Закрытый период: правка документов и операций с датой внутри периода запрещена на сервере (lib/finance/periodLock.ts).
// Исправления — только сторно/корректировочным документом. Повторное открытие — с обязательной причиной, запись остаётся.
model PeriodLock {
  id            String    @id @default(cuid())
  org           String
  from          String
  to            String
  note          String    @default("")
  lockedBy      String
  lockedByName  String    @default("")
  lockedAt      DateTime  @default(now())
  reopenedAt    DateTime?
  reopenedBy    String    @default("")
  reopenReason  String    @default("")

  @@index([org, reopenedAt])
  @@map("period_locks")
}

// Запрос специалиста клиенту («пришлите чек к платежу…»): виден клиенту в сводке, закрывается ответом
model ClientRequest {
  id          String    @id @default(cuid())
  org         String
  link        String    @default("")
  createdBy   String
  createdName String    @default("")
  subject     String
  body        String    @default("")
  entityType  String    @default("")
  entityId    String    @default("")
  // open | answered | cancelled
  status      String    @default("open")
  answer      String    @default("")
  answeredBy  String    @default("")
  answeredAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([org, status])
  @@map("client_requests")
}

// Паспорт интеграции (docs/TZ_MASTER.md §6): накладка поверх начальных паспортов из кода (lib/integrations/manifests.ts)
model IntegrationManifest {
  key       String   @id
  // available | beta | planned
  status    String   @default("planned")
  title     String   @default("")
  source    String   @default("")
  version   Int      @default(1)
  updatedBy String   @default("")
  updatedAt DateTime @updatedAt

  @@map("integration_manifests")
}

// Правило сверки фирмы: «контрагент/назначение содержит ... → статья». Задаёт владелец или специалист практики (уровень review и выше);
// применяется при загрузке выписки и по кнопке к ещё не размеченным движениям.
model PracticeRule {
  id            String   @id @default(cuid())
  org           String
  // counterparty | reference
  field         String   @default("counterparty")
  pattern       String
  category      String
  createdBy     String
  createdByName String   @default("")
  hits          Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([org])
  @@map("practice_rules")
}

// Робот-офис (docs/TZ_MASTER.md §3.2): роботы и поручения — таблицы, а не записи разделов
model Robot {
  id        String   @id @default(cuid())
  org       String
  rid       String
  data      Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([org, rid])
  @@index([org])
  @@map("robots")
}

model RobotTask {
  id        String   @id @default(cuid())
  org       String
  rid       String
  robot     String
  // queued | running | waiting | done | failed | cancelled
  status    String   @default("queued")
  data      Json
  createdAt DateTime @default(now())

  @@unique([org, rid])
  @@index([org, status])
  @@index([org, robot])
  @@map("robot_tasks")
}

// Реестр платформенных агентов (Rex, Sven, Ada…): сигналы жизни от внешних наблюдателей (agentwatch.py, Docker-агент) — необязательные адаптеры
model PlatformAgent {
  name         String   @id
  lastActivity DateTime?
  seenAt       DateTime?
  note         String   @default("")
  updatedAt    DateTime @updatedAt

  @@map("platform_agents")
}

// Банк-партнёр (docs/TZ_MASTER.md §7): канал привлечения и агрегаты; данных фирм банк не получает, кроме выбранного клиентом по согласию
model BankPartner {
  id          String   @id @default(cuid())
  name        String
  // провайдер из реестра банков (monobank | privatbank …), чей счёт показывается первым шагом
  bankProvider String  @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("bank_partners")
}

model BankPartnerCode {
  id        String   @id @default(cuid())
  partner   String
  code      String   @unique
  label     String   @default("")
  active    Boolean  @default(true)
  visits    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([partner])
  @@map("bank_partner_codes")
}

// Сотрудник банка с доступом к кабинету банка: видит только агрегаты и лиды, выданные клиентами
model BankPartnerMember {
  id        String   @id @default(cuid())
  partner   String
  user      String
  createdAt DateTime @default(now())

  @@unique([partner, user])
  @@index([user])
  @@map("bank_partner_members")
}

// Атрибуция: фирма пришла по коду банка. shareVolume — отдельное согласие клиента на учёт объёма платежей в агрегатах банка
model PartnerReferral {
  id          String   @id @default(cuid())
  partner     String
  code        String
  org         String
  shareVolume Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([partner, org])
  @@index([org])
  @@map("partner_referrals")
}

// Лид банку: клиент сам нажал «Получить предложение банка»; в snapshot — только выбранные им поля, на срок согласия
model BankLead {
  id        String    @id @default(cuid())
  partner   String
  org       String
  consent   String
  fields    String[]  @default([])
  snapshot  Json
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([partner, createdAt])
  @@index([org])
  @@map("bank_leads")
}

// Пакет изменений робота/правил практики (docs/TZ_MASTER.md §5.2 п. 9): сначала предложение, потом применение человеком, потом откат при необходимости
model PracticeBatch {
  id            String    @id @default(cuid())
  org           String
  // rules — применение правил сверки к неразмеченным движениям
  kind          String    @default("rules")
  // proposed | applied | rolled_back | dismissed
  status        String    @default("proposed")
  // [{ id, field, from, to, rule }]
  changes       Json
  skipped       Int       @default(0)
  createdBy     String
  createdByName String    @default("")
  appliedBy     String    @default("")
  appliedAt     DateTime?
  rolledBackAt  DateTime?
  createdAt     DateTime  @default(now())

  @@index([org, createdAt])
  @@map("practice_batches")
}

// Юристу (§5.2 п. 10): хранилище договоров клиента с версиями и статусами согласования
model LegalDoc {
  id             String    @id @default(cuid())
  org            String
  title          String
  counterparty   String    @default("")
  // draft | in_review | approved | rejected | signed | archived
  status         String    @default("draft")
  // срок (окончание/продление), YYYY-MM-DD; напоминание создаётся в календаре
  dueDate        String    @default("")
  reminderEvent  String?
  checklist      Json?
  currentVersion Int       @default(1)
  createdBy      String
  createdByName  String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([org, status])
  @@map("legal_docs")
}

model LegalDocVersion {
  id            String   @id @default(cuid())
  org           String
  doc           String
  n             Int
  body          String
  note          String   @default("")
  // текст подготовлен ИИ: везде показывается как «черновик для проверки специалистом»
  aiDraft       Boolean  @default(false)
  createdBy     String
  createdByName String   @default("")
  createdAt     DateTime @default(now())

  @@unique([doc, n])
  @@index([org, doc])
  @@map("legal_doc_versions")
}

model LegalTemplate {
  id        String   @id @default(cuid())
  org       String
  name      String
  body      String
  createdBy String
  createdAt DateTime @default(now())

  @@index([org])
  @@map("legal_templates")
}

// Журнал субподрядчиков платформы (ТЗ §5.2 п. 11): кто обрабатывает данные от нашего имени; видят практики, ведёт администратор платформы
model Subprocessor {
  id        String    @id @default(cuid())
  name      String
  purpose   String
  country   String    @default("")
  data      String    @default("")
  addedAt   DateTime  @default(now())
  removedAt DateTime?

  @@map("subprocessors")
}

// Комментарии к документам с упоминаниями (проверка бухгалтером, юристом): entityType invoices | expenses | legal
model DocComment {
  id         String   @id @default(cuid())
  org        String
  entityType String
  entityId   String
  author     String
  authorName String   @default("")
  text       String
  mentions   String[] @default([])
  createdAt  DateTime @default(now())

  @@index([org, entityType, entityId])
  @@map("doc_comments")
}

// Платежи Payme и Click (Узбекистан): провайдер сам вызывает адрес фирмы, транзакции хранятся для идемпотентности и сверки.
// Деньги идут напрямую фирме. Payme: id — 24-символьный идентификатор Payme; Click: id — click_trans_id, seq — merchant_prepare_id.
model UzPayTx {
  id          String    @id @default(cuid())
  seq         Int       @unique @default(autoincrement())
  org         String
  provider    String
  externalId  String
  invoiceId   String
  reference   String
  amount      Float
  state       Int       @default(1)
  reason      Int?
  extTime     BigInt?
  createdAt   DateTime  @default(now())
  performedAt DateTime?
  cancelledAt DateTime?

  @@unique([provider, externalId])
  @@index([org, invoiceId])
  @@map("uz_pay_tx")
}
