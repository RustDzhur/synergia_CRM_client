{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // Неиспользуемые импорты и переменные — ошибка, а не тихий мусор: правило ловит их на сборке,
    // без ESLint (в проекте он не установлен). Если параметр нужен по сигнатуре — начните имя с «_».
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // node_modules.nosync — та же папка зависимостей за пределами iCloud (см. .gitignore): без неё
  // в проверку попадали типы из node_modules, и, например, compat-объявление usePathname
  // (`string | null`) перебивало обычное из next/navigation
  "exclude": ["node_modules", "node_modules.nosync"]
}
